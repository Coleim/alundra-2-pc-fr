// Windows resources of the standalone game (icon and version information).
1 ICON "psxrecomp.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "Alundra 2 (portage PC)\0"
      VALUE "ProductName", "Alundra 2\0"
      VALUE "ProductVersion", "0.3.0\0"
      VALUE "OriginalFilename", "alundra2.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
